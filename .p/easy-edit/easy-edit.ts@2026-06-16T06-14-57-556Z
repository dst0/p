/**
 * easy-edit — Position-based file editing tools for Pi
 *
 * Replaces text-by-text matching with precise line/column offsets.
 * Every mutation tool (except easy:revert) creates a timestamped backup
 * in `.p/edits/` with project paths preserved.
 *
 * Place in:  ~/.p/agent/extensions/easy-edit.ts   (global)
 *            .p/extensions/easy-edit.ts             (project-local)
 *
 * Tools:
 *   easy:find    — locate text, return {line, position} ranges + length
 *   easy:copy    — copy a region (start + end or length) to clipboard
 *   easy:paste   — paste clipboard text at a given position
 *   easy:insert  — insert text at a given position
 *   easy:replace — replace a region with new text
 *   easy:revert  — undo the last edit on a file
 */

import { defineTool, type ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { Type } from "typebox";
import {
  readFileSync,
  writeFileSync,
  mkdirSync,
  copyFileSync,
  readdirSync,
  statSync,
} from "node:fs";
import { join, relative, resolve, dirname } from "node:path";

// ──────────────────────────────────────────────
//  Types
// ──────────────────────────────────────────────

interface Position {
  line: number;     // 1-based
  position: number; // 0-based column offset
}

// ──────────────────────────────────────────────
//  Backup / revert infrastructure
// ──────────────────────────────────────────────

function getEditsDir(cwd: string): string {
  const editsDir = join(cwd, ".p", "edits");
  mkdirSync(editsDir, { recursive: true });
  return editsDir;
}

/** Create a timestamped backup. Returns the absolute backup path. */
function createBackup(filePath: string, cwd: string): string {
  const absFile = resolve(cwd, filePath);
  const editsDir = getEditsDir(cwd);

  // Preserve relative project path inside edits/
  const relPath = relative(cwd, absFile);
  const backupDir = join(editsDir, dirname(relPath));
  mkdirSync(backupDir, { recursive: true });

  const timestamp = new Date().toISOString().replace(/[:.]/g, "-");
  const backupPath = join(backupDir, `${relPath}@${timestamp}`);
  copyFileSync(absFile, backupPath);
  return backupPath;
}

/** Revert file to its most recent backup. Returns backup path or null. */
function revertFile(filePath: string, cwd: string): string | null {
  const absFile = resolve(cwd, filePath);
  const editsDir = getEditsDir(cwd);
  const relPath = relative(cwd, absFile);
  const backupDir = join(editsDir, dirname(relPath));

  // Resolve the backup dir (handles ../ traversal for files outside project)
  const resolvedBackupDir = resolve(backupDir);
  if (!statSync(resolvedBackupDir).isDirectory()) return null;

  const files = readdirSync(resolvedBackupDir)
    .filter((f: string) => f.includes(basename(absFile) + "@"))
    .sort()
    .reverse();

  if (files.length === 0) return null;

  const latestBackup = join(resolvedBackupDir, files[0]);
  copyFileSync(latestBackup, absFile);
  return latestBackup;
}

// ──────────────────────────────────────────────
//  Position helpers
// ──────────────────────────────────────────────

/** Convert {line, position} to a byte offset in the full content string. */
function posToOffset(content: string, pos: Position): number {
  const lines = content.split("\n");
  let offset = 0;
  for (let i = 0; i < pos.line - 1 && i < lines.length; i++) {
    offset += lines[i].length + 1; // line content + newline
  }
  offset += pos.position;
  return Math.min(offset, content.length);
}

/** Read file and return full content + lines array. */
function readFile(filePath: string, cwd: string): { content: string; lines: string[] } {
  const abs = resolve(cwd, filePath);
  const content = readFileSync(abs, "utf-8");
  return { content, lines: content.split("\n") };
}

// ──────────────────────────────────────────────
//  Mutation helpers
// ──────────────────────────────────────────────

/** Insert text at {line, position}. Handles multiline insert text. */
function doInsert(content: string, pos: Position, text: string): string {
  const offset = posToOffset(content, pos);
  return content.slice(0, offset) + text + content.slice(offset);
}

/** Replace region [start..end) with newText. */
function doReplace(content: string, start: Position, end: Position, newText: string): string {
  const startOffset = posToOffset(content, start);
  const endOffset = posToOffset(content, end);
  return content.slice(0, startOffset) + newText + content.slice(endOffset);
}

/** Replace region [start..start+length) with newText. */
function doReplaceByLength(content: string, start: Position, length: number, newText: string): string {
  const startOffset = posToOffset(content, start);
  const endOffset = Math.min(startOffset + length, content.length);
  return content.slice(0, startOffset) + newText + content.slice(endOffset);
}

// ──────────────────────────────────────────────
//  Shared parameter schemas
// ──────────────────────────────────────────────

const PositionSchema = Type.Object({
  line: Type.Integer({ description: "Line number (1-based)" }),
  position: Type.Integer({ description: "Column offset (0-based)" }),
});

// ──────────────────────────────────────────────
//  In-memory clipboard
// ──────────────────────────────────────────────

let clipboard: { text: string; source: string } | null = null;

// ──────────────────────────────────────────────
//  Tool: easy:find
// ──────────────────────────────────────────────

const findTool = defineTool({
  name: "easy:find",
  label: "Easy Find",
  description:
    "Find occurrences of text in a file. Returns the file path, full path, and exact {line, position} for start and end of each match plus the match length.",
  promptSnippet:
    "Use easy:find to locate text in files and get precise line/column positions",
  promptGuidelines: [
    "Use easy:find before easy:copy, easy:replace, or easy:insert to get exact positions",
    "Lines are 1-based, positions (columns) are 0-based",
    "Use the returned positions directly with other easy:* tools",
  ],
  parameters: Type.Object({
    file: Type.String({ description: "Path to the file to search in" }),
    pattern: Type.String({ description: "Literal text pattern to search for (not regex)" }),
    maxResults: Type.Optional(
      Type.Integer({ description: "Max matches to return (default: 10)" }),
    ),
  }),
  async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
    const { file, pattern, maxResults = 10 } = params;
    const { content } = readFile(file, ctx.cwd);
    const absPath = resolve(ctx.cwd, file);

    const matches: Array<{
      start: Position;
      end: Position;
      length: number;
    }> = [];

    let searchStart = 0;
    while (matches.length < maxResults) {
      const idx = content.indexOf(pattern, searchStart);
      if (idx === -1) break;

      // Convert offset to {line, position}
      let line = 1;
      let col = 0;
      for (let i = 0; i < idx; i++) {
        if (content[i] === "\n") {
          line++;
          col = 0;
        } else {
          col++;
        }
      }

      // Compute end position — handle multiline patterns
      let eLine = line;
      let eCol = col;
      for (let i = 0; i < pattern.length; i++) {
        if (pattern[i] === "\n") {
          eLine++;
          eCol = 0;
        } else {
          eCol++;
        }
      }

      matches.push({
        start: { line, position: col },
        end: { line: eLine, position: eCol },
        length: pattern.length,
      });

      searchStart = idx + 1;
    }

    if (matches.length === 0) {
      return {
        content: [{ type: "text", text: `No matches for "${pattern}" in ${file}` }],
      };
    }

    const lines = matches
      .map((m, i) =>
        `  ${i + 1}. line ${m.start.line}:${m.start.position} → line ${m.end.line}:${m.end.position}  (length: ${m.length})`,
      )
      .join("\n");

    return {
      content: [{
        type: "text",
        text: `Found ${matches.length} match(es) for "${pattern}" in ${file}\nPath: ${absPath}\n\n${lines}`,
      }],
      details: { matches, filePath: absPath },
    };
  },
});

// ──────────────────────────────────────────────
//  Tool: easy:copy
// ──────────────────────────────────────────────

const copyTool = defineTool({
  name: "easy:copy",
  label: "Easy Copy",
  description:
    "Copy text from a file region to an internal clipboard. Specify start {line, position} and either end {line, position} or length. Creates a timestamped backup.",
  promptSnippet: "Use easy:copy to copy text regions by position",
  promptGuidelines: [
    "Use easy:find first to get exact positions",
    "Lines are 1-based, positions are 0-based",
  ],
  parameters: Type.Object({
    file: Type.String({ description: "Path to the file" }),
    start: PositionSchema,
    end: Type.Optional(Type.Object({
      line: Type.Integer({ description: "Line number (1-based)" }),
      position: Type.Integer({ description: "Column position (0-based)" }),
    }, { description: "End position (alternative to length)" })),
    length: Type.Optional(Type.Integer({ description: "Chars to copy (alternative to end)" })),
  }),
  async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
    const { file, start, end, length } = params;
    const { content } = readFile(file, ctx.cwd);

    const startOffset = posToOffset(content, start);
    let endOffset: number;

    if (end) {
      endOffset = posToOffset(content, end);
    } else if (length !== undefined) {
      endOffset = Math.min(startOffset + length, content.length);
    } else {
      return { content: [{ type: "text", text: "Error: provide either 'end' or 'length'" }] };
    }

    if (startOffset > endOffset) {
      return { content: [{ type: "text", text: "Error: 'start' must be before 'end'" }] };
    }

    const text = content.slice(startOffset, endOffset);

    // Backup
    const backup = createBackup(file, ctx.cwd);

    // Store clipboard
    clipboard = { text, source: file };

    const preview = text.length > 300 ? text.slice(0, 300) + "\n... (truncated)" : text;
    return {
      content: [{
        type: "text",
        text: `Copied ${text.length} char(s) from ${file}\n  start: line ${start.line}:${start.position}\n  end:   ${end ? `line ${end.line}:${end.position}` : `length ${length}`}\n  backup: ${backup}\n\n\`\`\`\n${preview}\n\`\`\``,
      }],
      details: { backup, length: text.length },
    };
  },
});

// ──────────────────────────────────────────────
//  Tool: easy:paste
// ──────────────────────────────────────────────

const pasteTool = defineTool({
  name: "easy:paste",
  label: "Easy Paste",
  description:
    "Paste previously copied text (from easy:copy) at {line, position}. Inserts without replacing. Creates a backup.",
  promptSnippet: "Use easy:paste to insert copied text at a position",
  promptGuidelines: [
    "Must call easy:copy first",
    "Inserts text — does not replace existing content",
  ],
  parameters: Type.Object({
    file: Type.String({ description: "Path to the file to paste into" }),
    start: PositionSchema,
  }),
  async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
    if (!clipboard) {
      return {
        content: [{ type: "text", text: "Error: clipboard empty. Use easy:copy first." }],
      };
    }

    const { file, start } = params;
    const { content } = readFile(file, ctx.cwd);
    const backup = createBackup(file, ctx.cwd);

    const newContent = doInsert(content, start, clipboard.text);
    const absFile = resolve(ctx.cwd, file);
    writeFileSync(absFile, newContent, "utf-8");

    return {
      content: [{
        type: "text",
        text: `Pasted ${clipboard.text.length} char(s) into ${file}\n  at line ${start.line}:${start.position}\n  backup: ${backup}`,
      }],
      details: { backup, pastedLength: clipboard.text.length },
    };
  },
});

// ──────────────────────────────────────────────
//  Tool: easy:insert
// ──────────────────────────────────────────────

const insertTool = defineTool({
  name: "easy:insert",
  label: "Easy Insert",
  description:
    "Insert text at {line, position}. Shifts existing content — nothing is removed. Creates a backup.",
  promptSnippet: "Use easy:insert to add text at a precise position",
  promptGuidelines: [
    "Insert shifts content — no text is removed",
    "Lines are 1-based, positions are 0-based",
  ],
  parameters: Type.Object({
    file: Type.String({ description: "Path to the file" }),
    start: PositionSchema,
    text: Type.String({ description: "Text to insert" }),
  }),
  async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
    const { file, start, text } = params;
    const { content } = readFile(file, ctx.cwd);
    const backup = createBackup(file, ctx.cwd);

    const newContent = doInsert(content, start, text);
    const absFile = resolve(ctx.cwd, file);
    writeFileSync(absFile, newContent, "utf-8");

    return {
      content: [{
        type: "text",
        text: `Inserted ${text.length} char(s) into ${file}\n  at line ${start.line}:${start.position}\n  backup: ${backup}`,
      }],
      details: { backup, insertedLength: text.length },
    };
  },
});

// ──────────────────────────────────────────────
//  Tool: easy:replace
// ──────────────────────────────────────────────

const replaceTool = defineTool({
  name: "easy:replace",
  label: "Easy Replace",
  description:
    "Replace a text region with new text. Specify start {line, position} and either end {line, position} or length. Creates a backup.",
  promptSnippet:
    "Use easy:replace to swap text by position — no exact-text matching required",
  promptGuidelines: [
    "Use easy:find first to get positions of text to replace",
    "No text matching — just positions and new content",
    "Lines are 1-based, positions are 0-based",
  ],
  parameters: Type.Object({
    file: Type.String({ description: "Path to the file" }),
    start: PositionSchema,
    end: Type.Optional(Type.Object({
      line: Type.Integer({ description: "Line number (1-based)" }),
      position: Type.Integer({ description: "Column position (0-based)" }),
    }, { description: "End position (alternative to length)" })),
    length: Type.Optional(Type.Integer({ description: "Chars to replace (alternative to end)" })),
    text: Type.String({ description: "Replacement text" }),
  }),
  async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
    const { file, start, end, length, text } = params;
    const { content } = readFile(file, ctx.cwd);

    const backup = createBackup(file, ctx.cwd);

    let newContent: string;
    let oldLength: number;

    if (end) {
      const sOff = posToOffset(content, start);
      const eOff = posToOffset(content, end);
      oldLength = eOff - sOff;
      newContent = doReplace(content, start, end, text);
    } else if (length !== undefined) {
      oldLength = length;
      newContent = doReplaceByLength(content, start, length, text);
    } else {
      return { content: [{ type: "text", text: "Error: provide either 'end' or 'length'" }] };
    }

    const absFile = resolve(ctx.cwd, file);
    writeFileSync(absFile, newContent, "utf-8");

    return {
      content: [{
        type: "text",
        text: `Replaced ${oldLength} → ${text.length} char(s) in ${file}\n  region: line ${start.line}:${start.position}${end ? ` → line ${end.line}:${end.position}` : ` (length ${length})`}\n  backup: ${backup}`,
      }],
      details: { backup, oldLength, newLength: text.length },
    };
  },
});

// ──────────────────────────────────────────────
//  Tool: easy:revert
// ──────────────────────────────────────────────

const revertTool = defineTool({
  name: "easy:revert",
  label: "Easy Revert",
  description:
    "Revert a file to its most recent backup (one step back). Does not create a new backup.",
  promptSnippet: "Use easy:revert to undo the last easy:* edit",
  promptGuidelines: [
    "Restores from the most recent timestamped backup",
    "One step back — call again for earlier versions",
  ],
  parameters: Type.Object({
    file: Type.String({ description: "Path to the file to revert" }),
  }),
  async execute(_toolCallId, params, _signal, _onUpdate, ctx) {
    const { file } = params;
    const result = revertFile(file, ctx.cwd);

    if (!result) {
      return {
        content: [{ type: "text", text: `No backup found for ${file}` }],
      };
    }

    return {
      content: [{
        type: "text",
        text: `Reverted ${file}\n  from: ${result}`,
      }],
      details: { restoredFrom: result },
    };
  },
});

// ──────────────────────────────────────────────
//  Extension entry
// ──────────────────────────────────────────────

export default function (pi: ExtensionAPI) {
  pi.registerTool(findTool);
  pi.registerTool(copyTool);
  pi.registerTool(pasteTool);
  pi.registerTool(insertTool);
  pi.registerTool(replaceTool);
  pi.registerTool(revertTool);
}
