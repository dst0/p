{
  "$schema": "https://raw.githubusercontent.com/dst0/p/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "vscode-dark",
  "vars": {
    "background": "#1e1e1e",
    "foreground": "#d4d4d4",
    "selection": "#264f78",
    "comment": "#6a9955",
    "blue": "#569cd6",
    "lightBlue": "#9cdcfe",
    "teal": "#4ec9b0",
    "yellow": "#dcdcaa",
    "orange": "#ce9178",
    "lightGreen": "#b5cea8",
    "purple": "#c586c0",
    "red": "#f44747",
    "accentBlue": "#007acc",
    "toolPendingBg": "#252526",
    "toolSuccessBg": "#1e2e1e",
    "toolErrorBg": "#321e1e",
    "userMsgBg": "#2d2d2d",
    "customMsgBg": "#332538"
  },
  "colors": {
    "accent": "accentBlue",
    "border": "#3c3c3c",
    "borderAccent": "blue",
    "borderMuted": "#2d2d2d",
    "success": "comment",
    "error": "red",
    "warning": "#ce9178",
    "muted": "#808080",
    "dim": "#666666",
    "text": "foreground",
    "thinkingText": "#808080",

    "selectedBg": "selection",
    "userMessageBg": "userMsgBg",
    "userMessageText": "foreground",
    "customMessageBg": "customMsgBg",
    "customMessageText": "foreground",
    "customMessageLabel": "purple",
    "toolPendingBg": "toolPendingBg",
    "toolSuccessBg": "toolSuccessBg",
    "toolErrorBg": "toolErrorBg",
    "toolTitle": "foreground",
    "toolOutput": "#808080",

    "mdHeading": "blue",
    "mdLink": "#3794ff",
    "mdLinkUrl": "#808080",
    "mdCode": "teal",
    "mdCodeBlock": "comment",
    "mdCodeBlockBorder": "#3c3c3c",
    "mdQuote": "#808080",
    "mdQuoteBorder": "accentBlue",
    "mdHr": "#3c3c3c",
    "mdListBullet": "blue",

    "toolDiffAdded": "comment",
    "toolDiffRemoved": "red",
    "toolDiffContext": "#808080",

    "syntaxComment": "comment",
    "syntaxKeyword": "blue",
    "syntaxFunction": "yellow",
    "syntaxVariable": "lightBlue",
    "syntaxString": "orange",
    "syntaxNumber": "lightGreen",
    "syntaxType": "teal",
    "syntaxOperator": "foreground",
    "syntaxPunctuation": "foreground",

    "thinkingOff": "#3c3c3c",
    "thinkingMinimal": "#808080",
    "thinkingLow": "blue",
    "thinkingMedium": "teal",
    "thinkingHigh": "purple",
    "thinkingXhigh": "red",

    "bashMode": "comment"
  },
  "export": {
    "pageBg": "#181818",
    "cardBg": "#1e1e1e",
    "infoBg": "#2d2d2d"
  }
}
