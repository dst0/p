[Unit]
Description=Pi Code Index Embedding Server
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 SCRIPT_PATH_PLACEHOLDER --port 8081 --model Qwen/Qwen3-Embedding-0.6B
WorkingDirectory=PKG_DIR_PLACEHOLDER
Restart=always
RestartSec=3
StandardOutput=append:/tmp/p-code-index-embedding.log
StandardError=append:/tmp/p-code-index-embedding.log
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
