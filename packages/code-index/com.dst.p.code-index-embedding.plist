<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dst.p.code-index-embedding</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>SCRIPT_PATH_PLACEHOLDER/embedding_server.py</string>
        <string>--port</string>
        <string>8081</string>
        <string>--model</string>
        <string>Qwen/Qwen3-Embedding-0.6B</string>
    </array>
    <key>WorkingDirectory</key>
    <string>SCRIPT_PATH_PLACEHOLDER</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/p-code-index-embedding.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/p-code-index-embedding.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
