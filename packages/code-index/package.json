{
  "name": "@dst0/p-code-index",
  "version": "0.4.169",
  "description": "Codebase indexer — hybrid dense (Qwen3-Embedding) + BM25 sparse vectors into Qdrant",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "code-index": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "embedding_server.py",
    "resource_manager.py",
    "requirements.txt",
    "README.md"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest --run && python3 -m unittest discover -s test -p 'test_*.py'",
    "test:coverage": "vitest --run --coverage",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "1.18.0",
    "fast-glob": "3.3.3",
    "ignore": "7.0.5"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "@vitest/coverage-v8": "4.1.8",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
