+export function findMatchingPlanItem(plan: PlanItem[], text: string): PlanItem | undefined {
+	return findPlanItemByIdOrText(plan, undefined, text);
+}
+
+function renderPlanStatusCode(status: PlanStatus): string {
+	switch (status) {
+		case "in_progress":
+			return ".";
+		case "done":
+			return "x";
+		case "failed":
+			return "-";
+		case "blocked":
+			return "!";
+		case "not_started":
+			return " ";
+	}
+}
+
+function selectPlanItemsForPrompt(plan: PlanItem[], limit: number): PlanItem[] {
+	const open = plan.filter((item) => item.status !== "done");
+	const done = plan.filter((item) => item.status === "done");
+	const selectedOpen = open.slice(0, limit);
+	const remaining = Math.max(0, limit - selectedOpen.length);
+	return [...selectedOpen, ...done.slice(-remaining)];
+}
+
+function selectOriginalRequestsForPrompt(
+	requests: OriginalUserRequest[] | undefined,
+	limit: number,
+): OriginalUserRequest[] {
+	if (!requests || requests.length <= limit) return requests ?? [];
+	const selected = [requests[0], ...requests.slice(-(limit - 1))];
+	const seen = new Set<string>();
+	return selected.filter((request) => {
+		if (seen.has(request.id)) return false;
+		seen.add(request.id);
+		return true;
+	});
+}
+
+function renderPromptStateSections(
+	state: StructuredSessionState,
+	options: { planLimit: number; fileLimit: number; evidenceLimit: number },
+): string[] {
+	const constraints = state.constraints
+		.filter((constraint) => constraint.status === "active")
+		.slice(0, 12)
+		.map(
+			(constraint) =>
+				`[${constraint.source}/${constraint.enforceability}] ${capPromptLine(constraint.text, 220)}`,
+		);
+	const plan = selectPlanItemsForPrompt(state.plan, options.planLimit).map(
+		(item) =>
+			`- [${renderPlanStatusCode(item.status)}] ${renderPlanStatusMarker(item.status)} ${capPromptLine(item.text, 220)}`,
+	);
+	const knownRisks = state.audit.knownRisks.map(
+		(risk) => `${STATE_RENDER_MARKERS.risk} ${capPromptLine(risk, 220)}`,
+	);
+	const requests = selectOriginalRequestsForPrompt(state.canonicalRequest.originalRequests, 4).map(
+		(request) => `${request.kind}: ${capPromptLine(request.summary, 200)}`,
+	);
+	const decisions = state.decisions
+		.filter((decision) => decision.status === "active")
+		.slice(-8)
+		.map((decision) =>
+			capPromptLine(`${decision.decision}${decision.rationale ? `: ${decision.rationale}` : ""}`, 240),
+		);
+	const touchedFiles = state.codebase.touchedFiles
+		.slice(-options.fileLimit)
+		.map((file) => `${file.status}: ${file.path} - ${capPromptLine(file.summary, 180)}`);
+	const evidence = state.evidence
+		.slice(-options.evidenceLimit)
+		.map((pointer) => `${pointer.id}: ${capPromptLine(pointer.summary, 180)}`);
+	return [
+		"Constraints:",
+		...renderList(constraints),
+		"Plan:",
+		...(plan.length > 0 ? plan : [`- [ ] ${STATE_RENDER_MARKERS.notStarted} (none)`]),
+		"Risks:",
+		...renderList(knownRisks),
+		"Requests:",
+		...renderList(requests),
+		"Decisions:",
+		...renderList(decisions),
+		"Files:",
+		...renderList(touchedFiles),
+		"Recall:",
+		"- Exact compacted messages and tool outputs remain outside the prompt. Use session_recall with specific keywords before guessing.",
+		...(evidence.length > 0 ? renderList(evidence) : []),
+	];
+}
+
+export function renderStructuredSessionCheckpoint(state: StructuredSessionState, maxTokens: number): string {
+	const lines = [
+		"<session_checkpoint>",
+		`${STATE_RENDER_MARKERS.goal} Goal: ${
+			capPromptLine(normalizeCanonicalRequest(state.canonicalRequest.current), 520) ||
+			"(no user request recorded yet)"
+		}`,
+		...renderPromptStateSections(state, { planLimit: 12, fileLimit: 16, evidenceLimit: 4 }),
+		"</session_checkpoint>",
+	];
+	return capCheckpoint(lines.join("\n"), maxTokens);
+}
+
+export function renderWorkingSessionState(state: StructuredSessionState, maxTokens: number): string | undefined {
+	if (!hasMeaningfulStructuredSessionState(state)) {
+		return undefined;
+	}
+	const lines = [
+		"<working_state>",
+		`${STATE_RENDER_MARKERS.goal} Goal: ${
+			capPromptLine(normalizeCanonicalRequest(state.canonicalRequest.current), 520) ||
+			"(no user request recorded yet)"
+		}`,
+		...renderPromptStateSections(state, { planLimit: 12, fileLimit: 12, evidenceLimit: 3 }),
+		"</working_state>",
+	];
+	return capWorkingState(lines.join("\n"), maxTokens);
+}
