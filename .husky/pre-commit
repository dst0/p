#!/bin/sh

# Get list of staged files before running check
STAGED_FILES=$(git diff --cached --name-only)

if ! node scripts/restage-precommit-files.js --assert-clean; then
  echo "❌ Partially staged files cannot be formatted safely."
  exit 1
fi

node scripts/check-lockfile-commit.js
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "❌ Checks failed. Please fix the errors before committing."
  exit 1
fi

RUN_BROWSER_SMOKE=0
for file in $STAGED_FILES; do
  case "$file" in
    packages/ai/*|packages/web-ui/*|package.json|package-lock.json)
      RUN_BROWSER_SMOKE=1
      break
      ;;
  esac
done

if [ $RUN_BROWSER_SMOKE -eq 1 ]; then
  echo "Running browser smoke check..."
  npm run check:browser-smoke
  if [ $? -ne 0 ]; then
    echo "❌ Browser smoke check failed."
    exit 1
  fi
fi

# Restage only files that remain staged after formatting. The helper uses
# NUL-delimited paths and force-adds already staged ignored evidence safely.
if ! node scripts/restage-precommit-files.js; then
  echo "❌ Failed to restage formatted files."
  exit 1
fi

echo "✅ All pre-commit checks passed!"
