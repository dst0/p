{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "*": ["./*"],
      "@dst0/p-ai": ["./packages/ai/src/index.ts"],
      "@dst0/p-ai/oauth": ["./packages/ai/src/oauth.ts"],
      "@dst0/p-ai/*": [
        "./packages/ai/src/*.ts",
        "./packages/ai/src/providers/*.ts"
      ],
      "@dst0/p-ai/dist/*": ["./packages/ai/src/*"],
      "@dst0/p-agent-core": ["./packages/agent/src/index.ts"],
      "@dst0/p-agent-core/*": ["./packages/agent/src/*"],
      "@dst0/p-coding-agent": ["./packages/coding-agent/src/index.ts"],
      "@dst0/p-coding-agent/hooks": [
        "./packages/coding-agent/src/core/hooks/index.ts"
      ],
      "@dst0/p-coding-agent/*": ["./packages/coding-agent/src/*"],
      "typebox": ["./node_modules/typebox"],
      "@dst0/p-tui": ["./packages/tui/src/index.ts"],
      "@dst0/p-tui/*": ["./packages/tui/src/*"],
      "@dst0/p-agent-old": ["./packages/agent-old/src/index.ts"],
      "@dst0/p-agent-old/*": ["./packages/agent-old/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "packages/coding-agent/examples/**/*"
  ],
  "exclude": [
    "**/dist/**",
    "packages/coding-agent/examples/extensions/gondolin/**"
  ]
}
